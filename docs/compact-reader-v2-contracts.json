          "description": ""
        },
        "book_id": {
          "type": "string",
          "description": ""
        },
        "source_revision": {
          "type": "string",
          "description": ""
        },
        "index_revision": {
          "type": "string",
          "description": ""
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "person",
            "group",
            "place",
            "organization",
            "object",
            "other"
          ]
        },
        "canonical_name": {
          "type": "string",
          "description": ""
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": ""
        },
        "mention_span_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": ""
        },
        "identity_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": ""
        },
        "same_as_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": ""
        },
        "identity_status": {
          "type": "string",
          "enum": [
            "resolved",
            "provisional",
            "ambiguous"
          ]
        },
        "temporary_identity_basis": {
          "type": "string",
          "description": "For unnamed people use an event/mention anchor, never a globally shared label such as unnamed master."
        }
      },
      "required": [
        "kind",
        "id",
        "book_id",
        "source_revision",
        "index_revision",
        "entity_type",
        "canonical_name",
        "aliases",
        "mention_span_ids",
        "identity_claim_ids",
        "same_as_candidates",
        "identity_status",
        "temporary_identity_basis"
