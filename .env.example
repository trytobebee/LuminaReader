# Copy to .env. Keep real credentials outside Git.
LUMINA_PROVIDER=openai
LUMINA_MODEL=gpt-6.1-sol
LUMINA_REASONING_EFFORT=medium
LUMINA_MODEL_BASE=https://api.openai.com
LUMINA_DB_PATH=data/reader_novel.db

# Supply OPENAI_API_KEY in your shell, or point to a private env file:
# LUMINA_OPENAI_ENV_FILE=/absolute/path/to/private.env
# Supported key names in that file: OPENAI_API_KEY or OpenAI_Key.

LUMINA_CHAT_MAX_CALLS=8
LUMINA_CHAT_MAX_DECISIONS=8
LUMINA_CHAT_MAX_STEPS=24
LUMINA_CHAT_MAX_SOURCE_CHARS=180000
LUMINA_CHAT_MAX_INPUT_CHARS=60000
LUMINA_CHAT_MAX_OUTPUT_TOKENS=5000
LUMINA_CHAT_MAX_COST_USD=0.50
